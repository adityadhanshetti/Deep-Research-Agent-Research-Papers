# ==============================================================================
# Deep Research Agent - Git Ignore Rules
# ==============================================================================

# 1. Environment & Sensitive Secrets (CRITICAL: Never commit API keys)
.env
.env.*
!.env.example

# 2. Python Bytecode, Caches & Distribution
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# 4. Streamlit Secrets & Internal Cache
.streamlit/secrets.toml

# 5. Generated Research Outputs & Benchmark Artifacts
outputs/
reports/
evaluation_results.json
evaluation_summary.md
*.log

# 6. Testing & Code Quality
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# 7. IDE, Editor & OS Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
